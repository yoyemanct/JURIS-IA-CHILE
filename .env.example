# Copia este archivo a ".env" (sin ".example") y pega tu clave real ahí.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# --- Proveedor de IA: Claude (nube, de pago) --------------------------
# Puedes dejar esto vacío si solo vas a usar Qwen local (ver más abajo).
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# Opcional: modelo de Claude a usar. Si no lo defines, se usa claude-sonnet-5.
CLAUDE_MODEL=claude-sonnet-5

# --- Proveedor de IA: Qwen local vía Ollama (gratis) --------------------
# Requiere tener Ollama instalado y corriendo en tu computador
# (https://ollama.com), con el modelo ya descargado, ej: "ollama pull qwen2.5"
# Pon esto en "false" para desactivar por completo la opción de Qwen local.
USAR_QWEN=true

# Opcional: URL donde corre Ollama en tu máquina. El valor por defecto
# funciona para una instalación normal de Ollama en el mismo computador.
OLLAMA_URL=http://localhost:11434

# Opcional: nombre exacto del modelo que descargaste en Ollama.
# Revísalo con el comando: ollama list
OLLAMA_MODEL=qwen2.5

# Opcional: cuánto esperar (en milisegundos) antes de darse por vencido
# consultando a Ollama. Los modelos locales pueden ser lentos, sobre todo
# la primera vez o en computadores sin tarjeta gráfica dedicada.
OLLAMA_TIMEOUT_MS=60000

# Opcional: "temperatura" del modelo local. Mientras más baja, más literal y
# pegado al texto de los artículos; mientras más alta, más creativo (y más
# riesgo de que invente). Para uso legal conviene dejarla baja.
OLLAMA_TEMPERATURA=0.15

# Opcional: tamaño de la ventana de contexto del modelo local. Ollama usa
# 4096 por defecto, que puede quedar corto para las instrucciones + los
# artículos legales que se le envían: si no cabe, Ollama corta el texto en
# silencio y el modelo responde sin haberlos leído completos. Subirlo mejora
# la calidad, pero consume más memoria RAM.
OLLAMA_NUM_CTX=8192

# Opcional: qué proveedor usar cuando el usuario no elige ninguno ("claude"
# o "qwen"). Si no lo defines, se usa Claude si hay ANTHROPIC_API_KEY
# configurada, o Qwen si no.
PROVEEDOR_IA_PREDETERMINADO=claude

# Opcional: puerto donde corre el servidor local.
PORT=3000

# Opcional: URL del servidor MCP con el corpus jurídico completo.
# Por defecto usa el proyecto open source "ley-chile" (leyes.pisanvs.cl),
# que reconstruye casi toda la legislación chilena desde la BCN.
LEYCHILE_MCP_URL=https://leyes.pisanvs.cl/api/mcp

# Opcional: pon esto en "false" para desactivar el corpus completo remoto
# y usar solo los ejemplos locales (útil para probar sin conexión, o si
# el servidor remoto está caído).
USAR_CORPUS_REMOTO=true

# --- Protecciones para cuando la app es pública -------------------------
# Cada pregunta llama a la API de Claude y se cobra a tu cuenta, así que
# estos límites evitan que alguien dispare miles de consultas.
# Preguntas a la IA permitidas por visitante (por IP) en cada ventana:
LIMITE_CONSULTAS_IA=15
# Búsquedas (sin IA, no tienen costo) por visitante en cada ventana:
LIMITE_BUSQUEDAS=60
# Duración de la ventana, en minutos:
VENTANA_MINUTOS=15
# Largo máximo de una pregunta, en caracteres:
MAX_LARGO_PREGUNTA=600
