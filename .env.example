# Copia este archivo a ".env" (sin ".example") y pega tu clave real ahí.
#
# EN VERCEL no copies este archivo entero: basta con agregar la variable
# AI_GATEWAY_API_KEY en Settings -> Environment Variables. Vercel no admite
# nombres propios que empiecen con "VERCEL_".
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# --- Proveedor de IA: Vercel AI Gateway (RECOMENDADO) -------------------
# Una sola clave da acceso a Claude, GPT, Gemini y otros, con respaldo
# automático entre modelos. Se crea en: vercel.com -> AI Gateway -> API Keys.
# Si despliegas en Vercel, la app puede autenticarse sola (token OIDC) y
# esta variable es opcional allí.
AI_GATEWAY_API_KEY=

# Modelo principal (formato "proveedor/modelo", ver vercel.com/ai-gateway/models).
# El gateway cobra por uso al precio del proveedor, e incluye un crédito
# mensual gratuito. Costo aproximado por informe completo:
#   anthropic/claude-haiku-4.5   ~US$0,017  rápido y preciso (por defecto)
#   google/gemini-2.5-flash      ~US$0,007  el más económico
#   anthropic/claude-sonnet-4.5  ~US$0,05   máxima calidad de análisis
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# Modelos que se prueban, en orden, si el principal falla antes de responder.
AI_GATEWAY_MODELOS_RESPALDO=google/gemini-2.5-flash

# Cuánto esperar (ms) a que el modelo empiece a responder antes de pasar al
# siguiente modelo de respaldo.
AI_GATEWAY_TIMEOUT_MS=30000

# --- Proveedor de IA: Claude directo (nube, de pago) --------------------
# Puedes dejar esto vacío si solo vas a usar Qwen local (ver más abajo).
ANTHROPIC_API_KEY=

# Opcional: modelo de Claude a usar. Si no lo defines, se usa claude-sonnet-5.
CLAUDE_MODEL=claude-sonnet-5

# --- Proveedor de IA: Qwen local vía Ollama (gratis) --------------------
# Requiere tener Ollama instalado y corriendo en tu computador
# (https://ollama.com), con el modelo ya descargado, ej: "ollama pull qwen2.5"
# Pon esto en "false" para desactivar por completo la opción de Qwen local.
# (En Vercel se desactiva sola, porque allí no hay Ollama; no la definas allí.)
# USAR_QWEN=true

# Opcional: URL donde corre Ollama en tu máquina. El valor por defecto
# funciona para una instalación normal de Ollama en el mismo computador.
OLLAMA_URL=http://localhost:11434

# Opcional: nombre exacto del modelo que descargaste en Ollama.
# Revísalo con el comando: ollama list
OLLAMA_MODEL=qwen2.5

# Opcional: cuánto esperar (en milisegundos) antes de darse por vencido
# consultando a Ollama. Los modelos locales pueden ser lentos, sobre todo
# la primera vez o en computadores sin tarjeta gráfica dedicada.
OLLAMA_TIMEOUT_MS=60000

# Opcional: "temperatura" del modelo local. Mientras más baja, más literal y
# pegado al texto de los artículos; mientras más alta, más creativo (y más
# riesgo de que invente). Para uso legal conviene dejarla baja.
OLLAMA_TEMPERATURA=0.15

# Opcional: tamaño de la ventana de contexto del modelo local. Ollama usa
# 4096 por defecto, que puede quedar corto para las instrucciones + los
# artículos legales que se le envían: si no cabe, Ollama corta el texto en
# silencio y el modelo responde sin haberlos leído completos. Subirlo mejora
# la calidad, pero consume más memoria RAM.
OLLAMA_NUM_CTX=8192

# Opcional: qué proveedor usar cuando el usuario no elige ninguno ("vercel",
# "claude" o "qwen"). Si no lo defines, se usa el primero disponible en ese
# orden.
PROVEEDOR_IA_PREDETERMINADO=vercel

# Opcional: puerto donde corre el servidor local (no hace falta en Vercel).
# PORT=3000

# Opcional: URL del servidor MCP con el corpus jurídico completo.
# Por defecto usa el proyecto open source "ley-chile" (leyes.pisanvs.cl),
# que reconstruye casi toda la legislación chilena desde la BCN.
LEYCHILE_MCP_URL=https://leyes.pisanvs.cl/api/mcp

# Opcional: pon esto en "false" para desactivar el corpus completo remoto
# y usar solo los ejemplos locales (útil para probar sin conexión, o si
# el servidor remoto está caído).
USAR_CORPUS_REMOTO=true

# --- Protecciones para cuando la app es pública -------------------------
# Cada pregunta llama a la API de Claude y se cobra a tu cuenta, así que
# estos límites evitan que alguien dispare miles de consultas.
# Preguntas a la IA permitidas por visitante (por IP) en cada ventana:
LIMITE_CONSULTAS_IA=15
# Búsquedas (sin IA, no tienen costo) por visitante en cada ventana:
LIMITE_BUSQUEDAS=60
# Duración de la ventana, en minutos:
VENTANA_MINUTOS=15
# Largo máximo de una pregunta, en caracteres:
MAX_LARGO_PREGUNTA=600

# --- Análisis de documentos propios ------------------------------------
# Tamaño máximo del archivo que se puede subir, en MB.
MAX_MB_ARCHIVO=20
# Cuánto texto del documento se le entrega al modelo. Si el documento es más
# largo, se seleccionan las secciones más relacionadas con la pregunta en vez
# de cortarlo por la mitad. Súbelo si tu modelo tiene una ventana grande.
DOC_PRESUPUESTO_CARACTERES=18000

# --- Velocidad ------------------------------------------------------------
# Tiempo máximo (ms) buscando en el corpus remoto. Si se agota, se usan las
# normas que alcanzaron a llegar.
TIMEOUT_BUSQUEDA_MS=12000
# Minutos que se guardan las búsquedas y las respuestas ya generadas. Una
# pregunta repetida se responde al instante.
CACHE_BUSQUEDA_MINUTOS=360
CACHE_RESPUESTAS_MINUTOS=360

# --- Jurisprudencia y doctrina ---------------------------------------------
# Pon "false" para desactivar la búsqueda de fallos (Poder Judicial, Tribunal
# Constitucional, Contraloría) o de doctrina (Crossref + OpenAlex).
USAR_JURISPRUDENCIA=true
USAR_DOCTRINA=true
# Tiempo máximo (ms) que se espera a cada fuente antes de seguir sin ella.
TIMEOUT_JURISPRUDENCIA_MS=15000
TIMEOUT_DOCTRINA_MS=12000
# Largo máximo de una guía de procedimiento (tokens de respuesta).
MAX_TOKENS_PROCEDIMIENTO=8000

# --- Cuentas y cobro con Mercado Pago --------------------------------------
# El cobro se activa SOLO cuando están las tres piezas: MP_ACCESS_TOKEN,
# SESSION_SECRET y la base de datos (KV_REST_API_URL + KV_REST_API_TOKEN, que
# Vercel agrega sola al crear Upstash Redis en Storage). Mientras falte alguna,
# la app funciona libre y sin cuentas, como antes.
# Access Token de PRODUCCIÓN de tu aplicación en Mercado Pago Developers.
MP_ACCESS_TOKEN=
# Clave secreta de las notificaciones (Webhooks) de Mercado Pago. Opcional pero recomendada.
MP_WEBHOOK_SECRET=
# Texto largo y aleatorio para firmar las sesiones (por ejemplo, 64 caracteres al azar).
SESSION_SECRET=
# Dirección pública de la app (para volver desde Mercado Pago y desde Google).
APP_URL=https://juris-ia-chile.vercel.app
# Planes.
PLAN_GRATIS_CONSULTAS=5
PLAN_PRO_NOMBRE=Pro
PLAN_PRO_PRECIO=19990
# 0 = consultas ilimitadas en el plan Pro.
PLAN_PRO_CONSULTAS=0
# Correos con acceso Pro sin pagar (tú y tu equipo), separados por coma.
ADMIN_EMAILS=
# Correo de contacto que se muestra para recuperar contraseñas.
CONTACTO_EMAIL=
# Ingreso con Google (opcional): credenciales OAuth de Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
