# Copia este archivo a ".env" (sin ".example") y pega tu clave real ahí.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# Opcional: modelo de Claude a usar. Si no lo defines, se usa claude-sonnet-5.
CLAUDE_MODEL=claude-sonnet-5

# Opcional: puerto donde corre el servidor local.
PORT=3000

# Opcional: URL del servidor MCP con el corpus jurídico completo.
# Por defecto usa el proyecto open source "ley-chile" (leyes.pisanvs.cl),
# que reconstruye casi toda la legislación chilena desde la BCN.
LEYCHILE_MCP_URL=https://leyes.pisanvs.cl/api/mcp

# Opcional: pon esto en "false" para desactivar el corpus completo remoto
# y usar solo los ejemplos locales (útil para probar sin conexión, o si
# el servidor remoto está caído).
USAR_CORPUS_REMOTO=true

# --- Protecciones para cuando la app es pública -------------------------
# Cada pregunta llama a la API de Claude y se cobra a tu cuenta, así que
# estos límites evitan que alguien dispare miles de consultas.
# Preguntas a la IA permitidas por visitante (por IP) en cada ventana:
LIMITE_CONSULTAS_IA=15
# Búsquedas (sin IA, no tienen costo) por visitante en cada ventana:
LIMITE_BUSQUEDAS=60
# Duración de la ventana, en minutos:
VENTANA_MINUTOS=15
# Largo máximo de una pregunta, en caracteres:
MAX_LARGO_PREGUNTA=600
